-/**
- * GameStateDispatcher — dispatches game start/leave events and applies per-game configs.
- *
- * Thermal profiles are handled by GameSpace's in-app ThermalController via
- * IProcessObserver. This dispatcher ensures per-game thermal profiles are set
- * in mithermal_app_profiles so GameSpace picks them up on foreground change.
- *
- * Per-game resolution uses Android's native CompatScale system via GameManagerService.
- * This scales the game's rendering buffer WITHOUT changing the global display resolution.
- * Result: no stutter, no flicker, no save/restore needed on game exit.
- */
-class GameStateDispatcher {
-
-    private static final String TAG = "GameStateDispatcher";
-    private static final String KEY_GAMING_MODE_ACTIVE = "ax_gaming_mode_active";
-    private static final String KEY_BYPASS_CHARGE_ENABLED = "bypass_charge_enabled";
-    private static final String KEY_POWER_MODE_PERF = "persist.sys.power_mode_perf";
-    private static final String KEY_POWER_MODE_PERF_BY_USER = "persist.sys.power_mode_perf_by_user";
-
-    // MiThermal per-app profiles key — shared with GameSpace ThermalController
-    private static final String KEY_MIPOWER_APP_PROFILES = "mithermal_app_profiles";
-    // Default thermal profile for games without explicit assignment
-    private static final int DEFAULT_GAME_PROFILE = 3; // Balanced Gaming (MGAME)
-
-    // Per-game resolution key
-    private static final String KEY_GAME_RESOLUTION = "gamespace_game_resolution";
-
-    // AFME (Adreno Frame Motion Engine) frame generation keys
-    private static final String KEY_AFME_MULTIPLIER = "gamespace_afme_multiplier";
-    private static final String KEY_AFME_FACTOR = "gamespace_afme_factor";
-    private static final String KEY_SGSR_MODE = "gamespace_sgsr_mode";
-    private static final String KEY_SMOOTH_MOTION = "gamespace_smooth_motion";
-    private static final String KEY_GPU_DEBUG_LAYERS_GLES = "gpu_debug_layers_gles";
-    private static final String KEY_GPU_DEBUG_LAYERS_VK = "gpu_debug_layers";
-    private static final String KEY_GPU_DEBUG_APP = "gpu_debug_app";
-    private static final String KEY_GPU_DEBUG_ENABLE = "enable_gpu_debug_layers";
-    private static final String AFME_GLES_LAYER = "libAFME_layer.so";
-    // Vulkan layer name = layer properties.layerName (from vkEnumerateInstanceLayerProperties)
-    private static final String AFME_VK_LAYER = "VK_LAYER_AFME_frame_gen";
-
-    // VRS (Variable Rate Shading) keys — per-game JSON map
-    private static final String KEY_VRS_LEVEL = "gamespace_vrs_level";
-
-    // Game Enhance (Color) keys — uses Xiaomi IDisplayFeature
-    private static final String KEY_GAME_ENHANCE_ENABLED = "gamespace_color_enhance";
-    // DisplayFeature modes for game color
-    private static final int DISPLAY_FEATURE_GAME_MODE = 26;
-    private static final int DISPLAY_FEATURE_GAME_STATE_ON = 1;
-    private static final int DISPLAY_FEATURE_GAME_STATE_OFF = 0;
-
-    private final Context mContext;
-    private final List<IGameSpaceCallback> mCallbacks;
-
-    private int mChargeControlLimit = 100;
-    private boolean mWasChargingControlEnabled = false;
-
-    // Resolution override tracking — only need to know if we applied one
-    private boolean mResolutionOverrideActive = false;
-    private String mOverridePackageName = null;
-
-    // AFME refresh-rate forcing — saved user values so they can be restored
-    // on game exit. NaN = nothing to restore.
-    private float mSavedMinRefreshRate = Float.NaN;
-    private float mSavedPeakRefreshRate = Float.NaN;
-    private boolean mRefreshRateForced = false;
-
-    // Live resolution rescale: while a game session is active, watch the
-    // per-app resolution map so panel changes apply immediately.
-    private String mActivePackage = null;
-    private ContentObserver mResolutionObserver = null;
-
-    GameStateDispatcher(Context context, List<IGameSpaceCallback> callbacks) {
-        mContext = context;
-        mCallbacks = callbacks;
-    }
-
-    private void registerResolutionObserver() {
-        if (mResolutionObserver != null) return;
-        mResolutionObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
-            @Override
-            public void onChange(boolean selfChange) {
-                final String pkg = mActivePackage;
-                if (pkg != null) {
-                    applyGameResolution(pkg);
-                }
-            }
-        };
-        mContext.getContentResolver().registerContentObserver(
-                Settings.System.getUriFor(KEY_GAME_RESOLUTION),
-                false, mResolutionObserver, UserHandle.USER_ALL);
-    }
-
-    private void unregisterResolutionObserver() {
-        if (mResolutionObserver == null) return;
-        mContext.getContentResolver().unregisterContentObserver(mResolutionObserver);
-        mResolutionObserver = null;
-    }
-
-    void dispatchGameState(boolean active, String packageName) {
-        Settings.Secure.putIntForUser(mContext.getContentResolver(),
-                KEY_GAMING_MODE_ACTIVE, active ? 1 : 0, UserHandle.USER_CURRENT);
-
-        for (IGameSpaceCallback callback : mCallbacks) {
-            try {
-                if (active && packageName != null) {
-                    callback.onGameStart(packageName);
-                } else {
-                    callback.onGameLeave();
-                }
-            } catch (Exception e) {
-                Slog.w(TAG, "Removing dead callback", e);
-                mCallbacks.remove(callback);
-            }
-        }
-
-        if (active) {
-            mActivePackage = packageName;
-            registerResolutionObserver();
-            ensureGameThermalProfile(packageName);
-            applyGameResolution(packageName);
-            applyAFME(packageName);
-            applyVRS(packageName);
-            applyGameEnhance(packageName);
-
-            if (bypassChargeEnabled()) {
-                mChargeControlLimit = getChargingLimit();
-                setBypassActive(true);
-                setSmartChargeLvl(battLevel());
-            }
-        } else {
-            unregisterResolutionObserver();
-            mActivePackage = null;
-            restoreResolution();
-            disableAFME();
-            disableVRS();
-            disableGameEnhance();
-
-            if (bypassChargeEnabled()) {
-                setBypassActive(false);
-                setSmartChargeLvl(mChargeControlLimit);
-            }
-        }
-    }
-
-    void boostGame(boolean enable) {
-        int perfByUser = Settings.System.getIntForUser(
-                mContext.getContentResolver(), KEY_POWER_MODE_PERF_BY_USER, 0,
-                UserHandle.USER_CURRENT);
-        if (perfByUser == 1) return;
-
-        Settings.System.putIntForUser(mContext.getContentResolver(),
-                KEY_POWER_MODE_PERF, enable ? 1 : 0,
-                UserHandle.USER_CURRENT);
-        SystemProperties.set(KEY_POWER_MODE_PERF, enable ? "1" : "0");
-    }
-
-    void setBypassCharge(boolean enable) {
-        if (!bypassChargeEnabled()) return;
-
-        if (enable) {
-            mChargeControlLimit = getChargingLimit();
-        }
-
-        setBypassActive(enable);
-        setSmartChargeLvl(enable ? battLevel() : mChargeControlLimit);
-    }
-
-    /**
-     * Ensure this game has a thermal profile in mithermal_app_profiles.
-     */
-    private void ensureGameThermalProfile(String packageName) {
-        if (packageName == null) return;
-
-        try {
-            String json = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_MIPOWER_APP_PROFILES, UserHandle.USER_CURRENT);
-
-            JSONObject profiles = (json != null && !json.isEmpty())
-                    ? new JSONObject(json) : new JSONObject();
-
-            if (!profiles.has(packageName)) {
-                profiles.put(packageName, DEFAULT_GAME_PROFILE);
-                Settings.System.putStringForUser(mContext.getContentResolver(),
-                        KEY_MIPOWER_APP_PROFILES, profiles.toString(),
-                        UserHandle.USER_CURRENT);
-                Slog.i(TAG, "Auto-assigned thermal profile " + DEFAULT_GAME_PROFILE
-                        + " to game: " + packageName);
-            }
-        } catch (Exception e) {
-            Slog.w(TAG, "Failed to ensure thermal profile for " + packageName, e);
-        }
-    }
-
-    /**
-     * Apply per-game resolution using Android's native CompatScale system.
-     *
-     * HOW IT WORKS (Qualcomm/Android native path):
-     * 1. GameManagerService.updateResolutionScalingFactor() sets the downscale factor
-     * 2. GameManagerService.LocalService implements CompatScaleProvider
-     * 3. When the game creates its window, WMS calls getCompatScale(packageName)
-     * 4. CompatScale adjusts the app's Configuration.densityDpi and window bounds
-     * 5. The game's SurfaceView/GLSurfaceView renders at the SCALED resolution
-     * 6. SurfaceFlinger composites the smaller buffer onto the native-res display
-     * 7. Result: game renders at lower res, display stays native, zero stutter
-     *
-     * NO setForcedDisplaySize — the physical display is NEVER changed.
-     * NO save/restore — CompatScale is per-process, auto-removed when game exits.
-     */
-    private void applyGameResolution(String packageName) {
-        if (packageName == null) return;
-
-        try {
-            String json = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_GAME_RESOLUTION, UserHandle.USER_CURRENT);
-
-            // Missing key or missing entry means "native": the panel REMOVES
-            // the per-app entry when the user picks 1.0, so an absent entry
-            // while an override is active must trigger a live revert.
-            double factor = 1.0;
-            if (json != null && !json.isEmpty()) {
-                factor = new JSONObject(json).optDouble(packageName, 1.0);
-            }
-            if (factor == 1.0) {
-                if (mResolutionOverrideActive) {
-                    restoreResolution(); // live revert (also updates windows)
-                }
-                return;
-            }
-
-            IGameManagerService gms = IGameManagerService.Stub.asInterface(
-                    ServiceManager.getService(Context.GAME_SERVICE));
-            if (gms == null) {
-                Slog.w(TAG, "GameManagerService not available");
