-    /**
-     * Enable AFME (Adreno Frame Motion Engine) GPU frame generation for this game.
-     *
-     * Uses Android's native EGL Layer system to inject the AFME layer into the game's
-     * GL pipeline. The layer intercepts eglSwapBuffers and uses
-     * GL_QCOM_frame_extrapolation hardware to generate synthetic frames between
-     * real game frames, effectively doubling the framerate.
-     *
-     * Controlled by per-game setting "gamespace_afme_multiplier" (JSON map: package → int).
-     * Values: 0=off, 2=2x, 3=3x, 4=4x frame generation.
-     */
-    private void applyAFME(String packageName) {
-        if (packageName == null) return;
-
-        try {
-            // Check if AFME multiplier is set for this game
-            String json = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_AFME_MULTIPLIER, UserHandle.USER_CURRENT);
-            if (json == null || json.isEmpty()) return;
-
-            JSONObject afmeMap = new JSONObject(json);
-            int multiplier = afmeMap.optInt(packageName, 0);
-            if (multiplier <= 0) return;
-
-            // Scope layer injection to this game. Read by the native bypasses
-            // in libvulkan (api.cpp) and libEGL (egl_layers.cpp) inside the
-            // game process — MUST be set before persist.sys.afme.enable so a
-            // racing process never sees enable=1 with an empty app filter.
-            SystemProperties.set("persist.sys.afme.app", packageName);
-
-            // Frame generation needs display headroom: force the panel rate
-            // for the session and publish it so the AFME layer can clamp its
-            // generation ratio to what the panel can show.
-            //
-            // FIFO presentation paces evenly only when total presents fill
-            // every vsync slot: a 45fps-capped game at 2x on a 90Hz panel is
-            // perfectly even (11.1ms cadence), while the same game on a
-            // 120Hz panel strobes ([real][synth] 8.3ms apart, then a gap).
-            // gamespace_afme_display_hz lets the user pick that matched rate;
-            // 0/absent = panel peak.
-            float peakHz = 60f;
-            float targetHz = 60f;
-            try {
-                DisplayManager dm = mContext.getSystemService(DisplayManager.class);
-                Display display = dm.getDisplay(Display.DEFAULT_DISPLAY);
-                for (Display.Mode mode : display.getSupportedModes()) {
-                    peakHz = Math.max(peakHz, mode.getRefreshRate());
-                }
-                targetHz = peakHz;
-                int hzOverride = Settings.System.getIntForUser(
-                        mContext.getContentResolver(),
-                        "gamespace_afme_display_hz", 0, UserHandle.USER_CURRENT);
-                if (hzOverride >= 60 && hzOverride <= Math.round(peakHz)) {
-                    targetHz = hzOverride;
-                }
-                mSavedMinRefreshRate = Settings.System.getFloatForUser(
-                        mContext.getContentResolver(), "min_refresh_rate",
-                        0f, UserHandle.USER_CURRENT);
-                mSavedPeakRefreshRate = Settings.System.getFloatForUser(
-                        mContext.getContentResolver(), "peak_refresh_rate",
-                        0f, UserHandle.USER_CURRENT);
-                Settings.System.putFloatForUser(mContext.getContentResolver(),
-                        "min_refresh_rate", targetHz, UserHandle.USER_CURRENT);
-                Settings.System.putFloatForUser(mContext.getContentResolver(),
-                        "peak_refresh_rate", targetHz, UserHandle.USER_CURRENT);
-                mRefreshRateForced = true;
-            } catch (Exception e) {
-                Slog.w(TAG, "AFME: could not force refresh rate", e);
-                targetHz = peakHz;
-            }
-            SystemProperties.set("persist.sys.afme.display_hz",
-                    String.valueOf(Math.round(targetHz)));
-
-            // Battery Saver votes the display down to 60Hz
-            // (DisplayModeDirector PRIORITY_LOW_POWER_MODE_RENDER_RATE) — the
-            // min_refresh_rate vote above loses to it. Warn so users know why
-            // generated frames get skipped.
-            boolean batterySaver = Settings.Global.getInt(
-                    mContext.getContentResolver(),
-                    Settings.Global.LOW_POWER_MODE, 0) != 0;
-            boolean saverCapsRefresh = Settings.Global.getInt(
-                    mContext.getContentResolver(), "low_power_refresh_rate", 1) != 0;
-            if (batterySaver && saverCapsRefresh) {
-                Slog.w(TAG, "AFME: Battery Saver caps the display at 60Hz — "
-                        + "frame generation beyond 60fps total will be skipped");
-            }
-
-            // Enable GPU debug layer system for this game
-            Settings.Global.putInt(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_ENABLE, 1);
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_APP, packageName);
-
-            // Set BOTH GLES and Vulkan layers — game uses whichever API it wants
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_LAYERS_GLES, AFME_GLES_LAYER);
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_LAYERS_VK, AFME_VK_LAYER);
-
-            // Enable the AFME layer via system properties
-            SystemProperties.set("persist.sys.afme.enable", "1");
-            SystemProperties.set("persist.sys.afme.multiplier", String.valueOf(multiplier));
-
-            // Session marker: drives init.target.rc perf triggers (GPU floor).
-            // Separate from persist.sys.afme.enable, which stays STAGED after
-            // game exit — libvulkan reads enable+app at vkCreateInstance time,
-            // which races this dispatcher on cold starts (measured: ZZZ splash
-            // focus-bounce left a 4s disabled window that Unity's instance
-            // creation landed in → layer silently skipped for the session).
-            SystemProperties.set("persist.sys.afme.session", "1");
-
-            // Propagate per-game AFME factor override (real-time, read every 64 frames)
-            String factorJson = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_AFME_FACTOR, UserHandle.USER_CURRENT);
-            String factor = "";
-            if (factorJson != null && !factorJson.isEmpty()) {
-                JSONObject factorMap = new JSONObject(factorJson);
-                factor = factorMap.optString(packageName, "");
-            }
-            SystemProperties.set("persist.sys.afme.factor", factor);
-
-            // Propagate per-game SGSR super resolution mode
-            String sgsrJson = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_SGSR_MODE, UserHandle.USER_CURRENT);
-            int sgsrMode = 0;
-            if (sgsrJson != null && !sgsrJson.isEmpty()) {
-                JSONObject sgsrMap = new JSONObject(sgsrJson);
-                sgsrMode = sgsrMap.optInt(packageName, 0);
-            }
-            SystemProperties.set("persist.sys.sgsr.enable", sgsrMode > 0 ? "1" : "0");
-            SystemProperties.set("persist.sys.sgsr.mode", String.valueOf(sgsrMode));
-
-            // Propagate per-game smooth motion setting
-            String smoothJson = Settings.System.getStringForUser(
-                    mContext.getContentResolver(),
-                    KEY_SMOOTH_MOTION, UserHandle.USER_CURRENT);
-            boolean smoothMotion = true; // default enabled
-            if (smoothJson != null && !smoothJson.isEmpty()) {
-                JSONObject smoothMap = new JSONObject(smoothJson);
-                smoothMotion = smoothMap.optBoolean(packageName, true);
-            }
-            // Use persist.sys.* namespace (system_prop context) since system_server
-            // cannot write vendor.display.* (neverallow in platform sepolicy)
-            SystemProperties.set("persist.sys.afme.smooth_motion", smoothMotion ? "1" : "0");
-
-            Slog.i(TAG, "AFME: Enabled " + multiplier + "x frame generation for " + packageName
-                    + " (factor=" + (factor.isEmpty() ? "auto" : factor)
-                    + ", sgsr=" + sgsrMode + ", smooth=" + smoothMotion + ")");
-        } catch (Exception e) {
-            Slog.w(TAG, "Failed to enable AFME", e);
-        }
-    }
-
-    /**
-     * Disable AFME frame generation on game exit.
-     */
-    private void disableAFME() {
-        try {
-            // End the session (init.target.rc reverts the GPU floor) but keep
-            // persist.sys.afme.enable + .app + .multiplier STAGED: libvulkan
-            // evaluates them at vkCreateInstance, seconds before this
-            // dispatcher can react to a cold start. Staged props are gated by
-            // package name, so no other process can match them, and the next
-            // launch of the same game activates the layer race-free.
-            SystemProperties.set("persist.sys.afme.session", "0");
-            SystemProperties.set("persist.sys.afme.factor", "");
-            SystemProperties.set("persist.sys.sgsr.enable", "0");
-            SystemProperties.set("persist.sys.sgsr.mode", "0");
-
-            // Restore the user's refresh-rate settings
-            if (mRefreshRateForced) {
-                try {
-                    Settings.System.putFloatForUser(mContext.getContentResolver(),
-                            "min_refresh_rate", mSavedMinRefreshRate,
-                            UserHandle.USER_CURRENT);
-                    Settings.System.putFloatForUser(mContext.getContentResolver(),
-                            "peak_refresh_rate", mSavedPeakRefreshRate,
-                            UserHandle.USER_CURRENT);
-                } catch (Exception e) {
-                    Slog.w(TAG, "AFME: could not restore refresh rate settings", e);
-                }
-                mRefreshRateForced = false;
-                mSavedMinRefreshRate = Float.NaN;
-                mSavedPeakRefreshRate = Float.NaN;
-            }
-
-            // Clear ALL GPU debug layer settings (both GLES and Vulkan)
-            // MUST run before vendor props which may throw
-            Settings.Global.putInt(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_ENABLE, 0);
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_APP, "");
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_LAYERS_GLES, "");
-            Settings.Global.putString(mContext.getContentResolver(),
-                    KEY_GPU_DEBUG_LAYERS_VK, "");
-
-            // Restore smooth motion to default
-            SystemProperties.set("persist.sys.afme.smooth_motion", "1");
-
-            Slog.i(TAG, "AFME: Disabled frame generation");
-        } catch (Exception e) {
-            Slog.w(TAG, "Failed to disable AFME", e);
-        }
-    }
