-                    KEY_VRS_LEVEL, UserHandle.USER_CURRENT);
-            if (json == null || json.isEmpty()) return;
-
-            JSONObject vrsMap = new JSONObject(json);
-            int level = vrsMap.optInt(packageName, 0);
-            if (level <= 0) return;
-
-            // Level 1: 2x1 ~25% GPU save | Level 2: 2x2 ~50% | Level 3: 4x4 ~60%
-            String rate;
-            switch (level) {
-                case 2: rate = "2x2"; break;
-                case 3: rate = "4x4"; break;
-                default: rate = "2x1"; break;
-            }
-
-            SystemProperties.set("debug.graphics.vrs.enable", "1");
-            SystemProperties.set("debug.graphics.vrs.rate", rate);
-            Slog.i(TAG, "VRS: Enabled level=" + level + " (" + rate
-                    + ") for " + packageName);
-        } catch (Exception e) {
-            Slog.w(TAG, "Failed to apply VRS", e);
-        }
-    }
