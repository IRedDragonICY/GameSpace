<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ireddragonicy.gamespace"
    android:sharedUserId="android.uid.system">

    <permission android:name="com.ireddragonicy.gamespace.permission.READ_PROCESSES" android:protectionLevel="signature|privileged" />
    <uses-permission android:name="com.ireddragonicy.gamespace.permission.READ_PROCESSES" />

    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.MANAGE_GAME_MODE" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <!-- AFME layer FPS stats arrive as AFME-STATS logcat lines: the layer runs
         inside the game (untrusted_app), which sepolicy forbids from setting
         system properties, so logcat is the only usable export channel. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="com.android.systemui.permission.SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FPS_COUNTER" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.TETHERING" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.MANAGE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="android.permission.DELETE_CACHE_FILES" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_COLOR_TRANSFORMS" />
    <!-- ThermalController: IActivityManager.registerProcessObserver for per-app profiles -->
    <uses-permission android:name="android.permission.SET_ACTIVITY_WATCHER" />

    <!--
        persistent: this process is the mithermald control plane — ThermalController
        and the foreground-app watcher have to survive independently of whether a
        game session happens to be open, which is exactly what the platform grants a
        persistent system app. Honoured only for system apps, which this is
        (android.uid.system, installed to the system image).

        NB: the app is intentionally not directBootAware, so the platform starts it
        in the MATCH_DIRECT_BOOT_AUTO pass — after user 0 is unlocked. Making it
        direct-boot aware would start it before credential encrypted storage exists
        and kill it in Application.onCreate; see the BootCompletedReceiver comment.
    -->
    <application
        android:name=".GameSpace"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/settings_title"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@style/GameSpaceTheme"
        android:enableOnBackInvokedCallback="true">
        
        <!-- GAME SPACE hub — Game Turbo-style game library, the launcher entry -->
        <activity
            android:name=".hub.GameHubActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game Space Settings -->
        <activity
            android:name=".hub.HubSettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".hub.GlobalProfileActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".settings.PerAppSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".settings.SidebarSettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".preferences.appselector.AppSelectorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_selector_label" />

        <activity
            android:name=".settings.fpsstats.FpsStatsActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".settings.fpsstats.FpsStatsDetailActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".settings.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".thermal.custom.CustomProfileListActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".thermal.custom.CustomProfileEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".charging.ChargingProfileListActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".charging.ChargingProfileEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/GameSpaceTheme" />

        <activity
            android:name=".settings.sidebarstudio.SidebarStudioActivity"
            android:exported="false"
            android:theme="@style/GameSpaceTheme" />

        <service
            android:name=".gamebar.GameSpaceService"
            android:exported="false" />

        <!--
            Deliberately NOT a foreground service. It never was one in the
            startForegroundService() sense — callers use startServiceAsUser(),
            so nothing ever required a startForeground() call — and the only
            thing the notification bought was process priority, which
            android:persistent already guarantees for the whole app. Being a
            plain started service costs one ongoing notification less.
        -->
        <service
            android:name=".gamebar.SessionService"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <service
            android:name=".gamebar.DanmakuServiceListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            BOOT_COMPLETED only, and deliberately not directBootAware.
            BootCompletedReceiver ignores LOCKED_BOOT_COMPLETED anyway, so
            declaring it bought nothing but started the process before user 0 was
            unlocked — where Hilt builds the singleton graph against credential
            encrypted storage and the app dies in Application.onCreate, before
            its own restart guard can run.
        -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
